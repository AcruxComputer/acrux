    "@prisma/client": "7.10.1",
    "@pump-fun/pump-sdk": "4.3.1",
    "@pump-fun/pump-swap-sdk": "2.2.0",
    "@solana/spl-token": "0.4.14",
    "@solana/web3.js": "1.98.4",
    "bn.js": "5.2.2",
    "hono": "4.13.16",
    "pg": "8.16.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bn.js": "5.2.0",
    "@types/node": "22.19.1",
    "@types/pg": "8.23.1",
    "prisma": "7.10.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
