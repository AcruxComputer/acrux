# node: every route from Acrux Net, the Hub Registry and the Fault Lab runner. fixture: the contract's fixtures.
MODE=node
HOST=127.0.0.1
PORT=4920
DATABASE_URL=postgresql://acrux:acrux@127.0.0.1:4921/acrux
CORS_ORIGINS=http://127.0.0.1:4910,http://localhost:4910,http://127.0.0.1:4911,http://localhost:4911
GATEWAY_RPC_URL=http://127.0.0.1:4930
# The node's private port: metrics and the faucet's grant route.
GATEWAY_INTERNAL_URL=http://127.0.0.1:4989
# The Solana cluster the Hub Registry lives on: the local validator here, HELIUS_RPC_URL on mainnet.
SOLANA_RPC_URL=http://127.0.0.1:4990
REGISTRY_PROGRAM_ID=ABjgHL8TcjxUjx6vfwsVQyvxiXR6pFgMkeESgwK6CbDm
REGISTRY_POLL_SECONDS=2
FAUCET_GRANT_LAMPORTS=2000000000
FAUCET_PER_KEY_LIMIT=3
FAUCET_PER_IP_LIMIT=10
FAUCET_WINDOW_SECONDS=86400
# The node binary (schedule preview and Fault Lab) and its working folder; the defaults are the local build.
# ACRUX_BIN=../node/target/live/acrux.exe
# ACRUX_NODE_DIR=../node
LAB_BASE_PORT=5016

# Solana creator-fee buyback. With no mint the keeper waits without chain calls.
ACRUX_MINT=
LAUNCH_WALLET=G9Hx9dH8tNCKdL1FogM2Qsy493Hp6SrG6re1hxkq5aD6
LAUNCH_KEYPAIR_FILE=/etc/acrux/launch-keypair.json
BUYBACK_LAUNCHPAD=launchlab
BUYBACK_POST_GRADUATION_BPS=2000
BUYBACK_INTERVAL_SECONDS=600
BUYBACK_SOL_FLOOR_LAMPORTS=20000000
BUYBACK_SLIPPAGE_BPS=300
BUYBACK_MIN_SWAP_LAMPORTS=50000000
BUYBACK_DRY_RUN=false
JUPITER_API_KEY=
# Requests a second the site's Solana relay (/v1/solana-rpc) may spend on SOLANA_RPC_URL.
SOLANA_RELAY_RPS=10
# The bridge (acrux_bridge) on Solana and on Acrux; unset, /v1/bridge waits.
BRIDGE_PROGRAM_ID=
BRIDGE_FROM_SLOT=
BRIDGE_POLL_SECONDS=60
