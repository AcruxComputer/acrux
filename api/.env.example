# node: every route from Acrux Net, the Hub Registry and the Fault Lab runner. fixture: the contract's fixtures.
MODE=node
HOST=127.0.0.1
PORT=4920
DATABASE_URL=postgresql://acrux:acrux@127.0.0.1:4921/acrux
CORS_ORIGINS=http://127.0.0.1:4910,http://localhost:4910,http://127.0.0.1:4911,http://localhost:4911
GATEWAY_RPC_URL=http://127.0.0.1:4930
# The node's private port: metrics and the faucet's grant route.
GATEWAY_INTERNAL_URL=http://127.0.0.1:4989
# The Solana cluster the Hub Registry lives on: the local validator here, a mainnet RPC URL in production.
SOLANA_RPC_URL=http://127.0.0.1:4990
REGISTRY_PROGRAM_ID=ABjgHL8TcjxUjx6vfwsVQyvxiXR6pFgMkeESgwK6CbDm
REGISTRY_POLL_SECONDS=2
FAUCET_GRANT_LAMPORTS=2000000000
FAUCET_PER_KEY_LIMIT=3
FAUCET_PER_IP_LIMIT=10
FAUCET_WINDOW_SECONDS=86400
# The node binary (schedule preview and Fault Lab) and its working folder; the defaults are the local build.
# ACRUX_BIN=../node/target/release/acrux
# ACRUX_NODE_DIR=../node
LAB_BASE_PORT=5016
