# Copy to acrux.env on the host. Every value here is the host's configuration.
ACRUX_DOMAIN=acrux.computer
# Browser origins allowed by the gateway and the API, comma separated, exact.
SITE_ORIGINS=https://acrux.computer,https://web-production-17baf5b9.up.railway.app
# Browser origins the gateway (JSON-RPC, its WebSocket, the event stream) accepts: * is every
# origin, as Solana's public RPCs serve wallets and dapps. The API keeps SITE_ORIGINS.
RPC_ORIGINS=*
POSTGRES_PASSWORD=
# Secrets of this host. The genesis file holds the faucet and mint-authority keys' seed
# (ACRUX_GENESIS_SEED=<secret> node scripts/genesis.mjs /etc/acrux/genesis.json in backend/chain);
# the identity seed derives the twelve validators, whose identities hold the Hub Registry memberships.
ACRUX_GENESIS_FILE=/etc/acrux/genesis.json
ACRUX_IDENTITY_SEED=
# The Hub Registry on Solana mainnet, through the shared Helius key (helius.env HELIUS_RPC_URL).
SOLANA_RPC_URL=
REGISTRY_CLUSTER=mainnet-beta
REGISTRY_PROGRAM_ID=ABjgHL8TcjxUjx6vfwsVQyvxiXR6pFgMkeESgwK6CbDm
REGISTRY_POLL_SECONDS=30
# Creator-fee buyback on Solana. Keep the mint blank until launch.
ACRUX_MINT=
LAUNCH_WALLET=G9Hx9dH8tNCKdL1FogM2Qsy493Hp6SrG6re1hxkq5aD6
LAUNCH_KEYPAIR_FILE=/etc/acrux/launch-keypair.json
BUYBACK_LAUNCHPAD=launchlab
BUYBACK_POST_GRADUATION_BPS=2500
BUYBACK_INTERVAL_SECONDS=600
BUYBACK_SOL_FLOOR_LAMPORTS=20000000
BUYBACK_SLIPPAGE_BPS=300
BUYBACK_MIN_SWAP_LAMPORTS=50000000
BUYBACK_DRY_RUN=false
JUPITER_API_KEY=
# Public limits.
ACRUX_RPC_RATE=50
ACRUX_SUBMIT_RATE=50
ACRUX_WS_PER_IP=8
FAUCET_PER_KEY_LIMIT=3
FAUCET_PER_IP_LIMIT=10
LAB_RUNS_PER_IP_HOUR=6
LAB_QUEUE_MAX=10
ACRUX_TRAFFIC_RATE=50
