# Copy to acrux.env on the host. Every value here is the host's configuration.
ACRUX_DOMAIN=acrux.computer
# Browser origins allowed by the gateway and the API, comma separated, exact.
SITE_ORIGINS=https://acrux.computer,https://web-production-17baf5b9.up.railway.app
# Browser origins the gateway (JSON-RPC, its WebSocket, the event stream) accepts: * is every
# origin, as Solana's public RPCs serve wallets and dapps. The API keeps SITE_ORIGINS.
RPC_ORIGINS=*
POSTGRES_PASSWORD=
# Secrets of this host. The genesis file holds the faucet and mint-authority keys' seed
# (ACRUX_GENESIS_SEED=<secret> node scripts/genesis.mjs /etc/acrux/genesis.json in backend/chain);
# the identity seed derives the twelve validators, whose identities hold the Hub Registry memberships.
ACRUX_GENESIS_FILE=/etc/acrux/genesis.json
ACRUX_IDENTITY_SEED=
# The Hub Registry on Solana mainnet, through the shared Helius key (helius.env HELIUS_RPC_URL).
SOLANA_RPC_URL=
REGISTRY_CLUSTER=mainnet-beta
REGISTRY_PROGRAM_ID=ABjgHL8TcjxUjx6vfwsVQyvxiXR6pFgMkeESgwK6CbDm
REGISTRY_POLL_SECONDS=30
# Creator-fee buyback on Solana. Keep the mint blank until launch.
ACRUX_MINT=
LAUNCH_WALLET=G9Hx9dH8tNCKdL1FogM2Qsy493Hp6SrG6re1hxkq5aD6
LAUNCH_KEYPAIR_FILE=/etc/acrux/launch-keypair.json
BUYBACK_LAUNCHPAD=launchlab
BUYBACK_POST_GRADUATION_BPS=2000
BUYBACK_INTERVAL_SECONDS=600
BUYBACK_SOL_FLOOR_LAMPORTS=20000000
BUYBACK_SLIPPAGE_BPS=300
BUYBACK_MIN_SWAP_LAMPORTS=50000000
BUYBACK_DRY_RUN=false
JUPITER_API_KEY=
# Public limits.
ACRUX_RPC_RATE=50
ACRUX_SUBMIT_RATE=50
ACRUX_WS_PER_IP=8
# Stream connections in all (the event stream and the RPC host's WebSocket together).
ACRUX_WS_MAX=200
# Transactions people send, kept by signature, id and address: days, and at most this many.
ACRUX_KEEP_DAYS=7
ACRUX_KEEP_MAX=200000
FAUCET_PER_KEY_LIMIT=3
FAUCET_PER_IP_LIMIT=10
LAB_RUNS_PER_IP_HOUR=6
LAB_QUEUE_MAX=10
ACRUX_TRAFFIC_RATE=50

# Bridge on both chains; no program leaves the relayer waiting.
BRIDGE_PROGRAM_ID=
BRIDGE_FROM_SLOT=
BRIDGE_POLL_SECONDS=60

# Separate Solana fee wallet; the operator supplies this mode-600 file.
BRIDGE_RELAYER_KEYPAIR_FILE=/etc/acrux/bridge-relayer/keypair.json
BRIDGE_RELAYER_INTERVAL_SECONDS=15
# Keeper-to-node acknowledgement; private container-network port, never the public RPC.
GATEWAY_INTERNAL_URL=http://net:4989
# Save finalized cblocks before the separate pay and oldest-due retry budgets.
BRIDGE_RELAYER_MAX_SAVED_CBLOCKS_PER_CYCLE=512
BRIDGE_RELAYER_MAX_NEW_WITHDRAWALS_PER_CYCLE=10
BRIDGE_RELAYER_MAX_RETRY_WITHDRAWALS_PER_CYCLE=10

# Node: required with a bridge rule. Soft shedding level, never an insert refusal.
# Epoch representatives and young withdrawal proofs stay even above this level.
ACRUX_BRIDGE_PROOF_MAX=100000
# Shed old unpaid non-representatives only after this many slots (24 hours at 50 ms).
ACRUX_BRIDGE_PROOF_GRACE_SLOTS=1728000

# Bridge rule and TWO independent Solana providers; leave rule blank until launch.
# Host rule path when enabled: /etc/acrux/bridge/bridge.json (its folder mounted read-only).
ACRUX_BRIDGE=
# ACRUX_BRIDGE_RPC=https://provider-one.example/rpc,https://provider-two.example/rpc
ACRUX_BRIDGE_RPC=
