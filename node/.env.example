ACRUX_GATEWAY_PORT=4930
ACRUX_WS_PORT=4931
ACRUX_BASE_PORT=4950
ACRUX_METRICS_PORT=4989
ACRUX_BCU=2000000
ACRUX_INCLUSION_FEE=1000
ACRUX_BASE_FEE=5000
ACRUX_RESERVE=1000000
ACRUX_FRAGMENT_EXPIRY=8
ACRUX_TRAFFIC_RATE=50
ACRUX_RETAIN_SLOTS=24000
# 127.0.0.1 locally; 0.0.0.0 in a container.
ACRUX_BIND=127.0.0.1
ACRUX_CORS_ORIGINS=http://127.0.0.1:4910,http://localhost:4910,http://127.0.0.1:4911,http://localhost:4911

# Required when chain/bridge.json (or ACRUX_BRIDGE) enables the bridge.
# Number of archived withdrawal cblock / epoch proofs, beyond the rolling window.
# Choose a capacity for the supported downtime and peak withdrawal volume.
ACRUX_BRIDGE_PROOF_MAX=100000

# Bridge rule and TWO independent Solana providers; leave rule blank until launch.
# Host rule path when enabled: /etc/acrux/bridge.json (mounted read-only).
ACRUX_BRIDGE=
# ACRUX_BRIDGE_RPC=https://provider-one.example/rpc,https://provider-two.example/rpc
ACRUX_BRIDGE_RPC=
